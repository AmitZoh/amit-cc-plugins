#!{{PYTHON}}
# Generated by agent-sandbox-provision (bind-mongodb). Do NOT edit by hand;
# re-created by bind-mongodb, removed by unbind-mongodb when the last DB reached
# through this cluster is unbound.
#
# Per-CLUSTER, PER-SESSION SOCKS5 tunnel helper for {{VIA_CLUSTER}}. Runs as the REAL
# user (the engineer), called by claude-ro through a pinned
#     sudo -u <user> /usr/local/bin/claude-ro-tunnel-{{LABEL}} <session_id> [port]
# rule. Standing up the tunnel needs cluster WRITE (create a proxy Deployment +
# port-forward), which claude-ro's read-only role cannot do — so it runs as the engineer.
#
# It runs under sudo with a STRIPPED environment (no KUBECONFIG — the engineer's is a
# set of per-cluster files referenced via an env var sudo won't pass through — and no
# guarantee that `aws` is on PATH for the usual exec-plugin). So it does NOT use the
# engineer's kubeconfig. Instead it mints its OWN self-contained admin kubeconfig via
# boto3: it parses the account+region from the cluster ARN, looks up that account's
# assumer_profile (recorded by provision-account), and signs a static EKS bearer token
# as that identity — correct across multiple accounts. kubectl is invoked by absolute
# path, so sudo's PATH doesn't matter either. The temp kubeconfig holds a WRITE token,
# so it's a mode-600 file in the engineer's private temp dir (never claude-ro-readable)
# and is deleted as soon as the port-forward is established.
#
# Args:
#   session_id  (required) the launcher's CLAUDE_RO_SESSION — tags this session's tunnel
#               so the launcher tears down ONLY its own on exit.
#   port        (optional) reuse a specific local port. Omitted → a free port is picked
#               and printed; the agent passes it to claude-ro-mint-mongodb and back here
#               to reuse the SAME port if the tunnel later drops.
#
# Each (session, port) gets its OWN proxy Deployment (claude-ro-socks-<port>) and its
# OWN port-forward. The PF pid + deployment + cluster ARN are recorded in
#     /usr/local/claude-ro-runtime/tunnel/<session_id>.<port>.pid
# so the launcher (which DOES have the engineer's kubeconfig, in its full env) can delete
# the deployment and kill the forward on exit. No self-healing loop — if the pod is
# evicted, claude-ro re-runs this with the same port. Prints only '<cluster> <port>'.
from __future__ import annotations

import os
import pwd
import socket
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, "{{SKILL_SCRIPTS_DIR}}")
import _common as common  # noqa: E402

VIA_CLUSTER = "{{VIA_CLUSTER}}"
KUBECTL = "{{KUBECTL}}"  # absolute path resolved at bind time (sudo PATH may lack it)


def _kc(*args: str) -> subprocess.CompletedProcess:
    # KUBECONFIG is set in os.environ (the minted admin kubeconfig); inherited here.
    return subprocess.run([KUBECTL, *args], capture_output=True, text=True, check=False)


def _kc_err(proc: subprocess.CompletedProcess) -> str:
    return (proc.stderr or proc.stdout or "").strip()


def _port_listening(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.5)
        return s.connect_ex(("127.0.0.1", port)) == 0


def _free_port() -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def _pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # exists but owned by another user
    return True


def main() -> None:
    os.environ["HOME"] = pwd.getpwuid(os.getuid()).pw_dir

    if len(sys.argv) < 2 or len(sys.argv) > 3:
        print(f"usage: {os.path.basename(sys.argv[0])} <session_id> [port]", file=sys.stderr)
        sys.exit(2)
    session_id = common.sanitize_session_id(sys.argv[1])
    port = common.sanitize_port(sys.argv[2]) if len(sys.argv) > 2 else None

    if port is not None:
        # Reuse path: is this exact port already OUR live tunnel for this session?
        pidfile_name = f"{session_id}.{port}.pid"
        existing = common.read_runtime_cred("tunnel", pidfile_name)
        if existing and _port_listening(port):
            head = existing.split("\t")[0]
            if head.isdigit() and _pid_alive(int(head)):
                sys.stdout.write(f"{VIA_CLUSTER} {port}\n")
                return
        if _port_listening(port):
            print(f"claude-ro-tunnel: local port {port} is held by another process; "
                  "not riding it. Pick a different port or free it.", file=sys.stderr)
            sys.exit(1)
    else:
        port = _free_port()
        pidfile_name = f"{session_id}.{port}.pid"

    # Mint a self-contained admin kubeconfig for this cluster's account (boto3, no aws
    # CLI / exec plugin / engineer KUBECONFIG). The temp file holds a WRITE token, so it
    # is mode-600 in the engineer's private temp dir and deleted once the tunnel is up.
    account, region, cluster_name = common.parse_eks_arn(VIA_CLUSTER)
    profile = common.aws_account_record(account)["assumer_profile"]  # account is provisioned (bind enforced)
    aws = common.load_provider("aws")
    kcfg_text = aws.mint_admin_kubeconfig(account, region, cluster_name, profile)
    fd, kpath = tempfile.mkstemp(prefix="claude-ro-tunnel-", suffix=".kubeconfig")
    os.write(fd, kcfg_text.encode("utf-8"))
    os.close(fd)
    os.chmod(kpath, 0o600)
    os.environ["KUBECONFIG"] = kpath

    try:
        deployment = f"claude-ro-socks-{port}"
        # Hardcoded, NOT env-overridable: this broker runs as the engineer with
        # cluster-admin, so whoever picks the image picks what runs in the cluster. sudo
        # strips the environment today, but that is a property of the sudoers file rather
        # than of this script — an env_keep would silently hand image choice to claude-ro.
        # The whole design is that argv and env cannot change what this broker does.
        image = "serjs/go-socks5-proxy"

        # 1. Ensure the SOCKS proxy Deployment exists. kubectl stderr is SURFACED on any
        #    unexpected failure so a real cluster/auth error isn't swallowed.
        got = _kc("get", "deployment", deployment)
        if got.returncode != 0:
            err = _kc_err(got)
            if "NotFound" not in err and "not found" not in err.lower():
                print(f"claude-ro-tunnel: `kubectl get deployment` failed on {VIA_CLUSTER}:\n{err}",
                      file=sys.stderr)
            created = _kc("create", "deployment", deployment, "--image", image)
            if created.returncode != 0:
                print(f"claude-ro-tunnel: `kubectl create deployment` failed on {VIA_CLUSTER}:\n"
                      f"{_kc_err(created)}", file=sys.stderr)
                sys.exit(1)
            # serjs/go-socks5-proxy defaults REQUIRE_AUTH=true and crash-loops without a
            # user/password; run it open — reachable only via the localhost forward.
            set_env = _kc("set", "env", "deployment/" + deployment, "REQUIRE_AUTH=false")
            if set_env.returncode != 0:
                print(f"claude-ro-tunnel: `kubectl set env` failed on {VIA_CLUSTER}:\n"
                      f"{_kc_err(set_env)}", file=sys.stderr)
        rolled = _kc("rollout", "status", "deployment/" + deployment, "--timeout=90s")
        if rolled.returncode != 0:
            print(f"claude-ro-tunnel: `kubectl rollout status` did not complete on {VIA_CLUSTER}:\n"
                  f"{_kc_err(rolled)}", file=sys.stderr)

        # 2. Detached port-forward (start_new_session) so it outlives this helper and the
        #    kubeconfig deletion below. Record pid + deployment + cluster ARN, tagged by
        #    session, for the launcher's teardown (it uses its own kubeconfig).
        proc = subprocess.Popen(
            [KUBECTL, "port-forward", "deployment/" + deployment, f"{port}:1080"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL, start_new_session=True,
        )
        common.write_runtime_cred(
            "tunnel", pidfile_name, f"{proc.pid}\t{deployment}\t{VIA_CLUSTER}\n")

        # 3. Wait for the local port. Once it answers, the forward has authenticated with
        #    the token, so the kubeconfig file is no longer needed (deleted in finally).
        for _ in range(40):
            if _port_listening(port):
                sys.stdout.write(f"{VIA_CLUSTER} {port}\n")
                return
            time.sleep(0.5)
        print(f"claude-ro-tunnel: port {port} never came up for {VIA_CLUSTER}", file=sys.stderr)
        sys.exit(1)
    finally:
        try:
            os.unlink(kpath)  # remove the WRITE-token kubeconfig promptly
        except OSError:
            pass


if __name__ == "__main__":
    main()
