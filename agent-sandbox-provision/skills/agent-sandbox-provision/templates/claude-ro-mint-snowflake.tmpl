#!{{PYTHON}}
# Generated by agent-sandbox-provision (bind-snowflake). Do NOT edit by hand;
# re-created by bind-snowflake, removed by unbind-snowflake when the LAST account is
# unbound.
#
# SHARED mint helper for ALL bound Snowflake accounts. Runs as the REAL user, called by
# claude-ro through a pinned `sudo -u <user> <this path>` rule (see
# /etc/sudoers.d/claude-ro-mint-snowflake). It takes NO arguments — argv is rejected
# outright, so there is no argument surface to validate or abuse.
#
# For each bound account it reads the durable RSA private key (which claude-ro cannot
# read), signs a short-lived JWT LOCALLY, and WRITES it to a mode-600 file under the
# runtime dir:
#     /usr/local/claude-ro-runtime/snowflake/<name>.json
# The file is claude-ro-readable via the runtime dir's inherited allow-ACE. To stdout it
# prints ONLY non-secret metadata — one `<name> <file-path>` line per account — so the
# token never transits stdout / the model's context.
#
# Signing is local: there is no network call here, so this cannot fail because Snowflake
# is unreachable. Snowflake caps key-pair JWTs at 60 minutes regardless of the signed
# exp, so the agent should re-run this rather than cache what it reads.
from __future__ import annotations

import sys

sys.path.insert(0, "{{SKILL_SCRIPTS_DIR}}")
import _common as common  # noqa: E402


def main() -> None:
    if len(sys.argv) > 1:
        print("usage: claude-ro-mint-snowflake  (takes no arguments)", file=sys.stderr)
        sys.exit(2)

    state = common.state_read()  # stdlib-only path (no validation/jsonschema)
    provider = common.load_provider("snowflake")
    records = state.get("snowflake") or []

    for record in records:
        name = record["name"]
        # Always re-sign. There is no caching branch because signing is local and
        # costs nothing — no network call, no remote object, nothing to rotate. A
        # cache here would only add a way to hand out a stale token.
        secret = common.secret_read(record["secret_ref"])
        creds = provider.mint(record, secret)
        path = common.write_runtime_cred(
            "snowflake", f"{name}.json", creds["SNOWFLAKE_JSON"])
        sys.stdout.write(f"{name} {path}\n")  # non-secret: name + file path only


if __name__ == "__main__":
    main()
