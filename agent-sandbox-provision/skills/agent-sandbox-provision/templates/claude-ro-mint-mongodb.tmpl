#!{{PYTHON}}
# Generated by agent-sandbox-provision (bind-mongodb). Do NOT edit by hand;
# re-created by bind-mongodb, removed by unbind-mongodb when the LAST DB is unbound.
#
# SHARED mint helper for ALL bound MongoDB databases. Runs as the REAL user, called by
# claude-ro through a pinned `sudo -u <user> <this path> [port]` rule (see
# /etc/sudoers.d/claude-ro-mint-mongodb). For each bound DB it reads the durable secret
# (which claude-ro cannot read), assembles the connection string, and WRITES it to a
# mode-600 file under the runtime dir:
#     /usr/local/claude-ro-runtime/mongodb/<name>.uri
# The file is claude-ro-readable via the runtime dir's inherited allow-ACE. To stdout it
# prints ONLY non-secret metadata — one `<name> <file-path>` line per DB — so the
# connection string (with its password) never transits stdout / the model's context.
#
# argv[1] (optional): the SOCKS port of the per-session tunnel, as returned by the
# per-cluster claude-ro-tunnel broker. It is validated as a plain port number and baked
# into tunneled DBs' URIs as proxyPort. It is NOT a security boundary — claude-ro holds
# the Mongo password (it's in the URI it reads) and has a shell, so it can already reach
# any port; the port arg only selects which live tunnel a tunneled DB routes through.
# Tunneled DBs require the port; if bound tunneled DBs span more than one cluster (one
# port can't serve two) it errors rather than misroute.
from __future__ import annotations

import sys

sys.path.insert(0, "{{SKILL_SCRIPTS_DIR}}")
import _common as common  # noqa: E402


def main() -> None:
    port = common.sanitize_port(sys.argv[1]) if len(sys.argv) > 1 else None
    if len(sys.argv) > 2:
        print("usage: claude-ro-mint-mongodb [port]", file=sys.stderr)
        sys.exit(2)

    state = common.state_read()  # stdlib-only path (no validation/jsonschema)
    provider = common.load_provider("mongodb")
    records = state.get("mongodb") or []

    tunneled_clusters = {r["via_cluster"] for r in records if r.get("via_cluster")}
    if tunneled_clusters and port is None:
        raise SystemExit(
            "tunneled MongoDB DBs need the tunnel port: start the cluster's "
            "claude-ro-tunnel broker and pass the port it prints.")
    if len(tunneled_clusters) > 1:
        raise SystemExit(
            "bound tunneled DBs span more than one cluster "
            f"({sorted(tunneled_clusters)}); one SOCKS port can't serve both. "
            "Unbind the DBs on one cluster, or mint per cluster (not yet supported).")

    for record in records:
        pp = port if record.get("via_cluster") else None
        if record.get("auth") == "aws_iam":
            # No stored secret: the URI carries no password (MONGODB-AWS); auth is
            # claude-ro's minted RO creds from the environment at connect time.
            creds = provider.mint(record, proxy_port=pp)
        else:
            secret = common.secret_read(record["secret_ref"])
            creds = provider.mint(record, secret, proxy_port=pp)
        path = common.write_runtime_cred("mongodb", f"{record['name']}.uri", creds["MONGODB_URI"])
        sys.stdout.write(f"{record['name']} {path}\n")  # non-secret: name + file path only


if __name__ == "__main__":
    main()
