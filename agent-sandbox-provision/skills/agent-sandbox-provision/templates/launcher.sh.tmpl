#!/usr/bin/env bash
# /usr/local/bin/claude-ro — read-only sandbox launcher.
# Generated by agent-sandbox-provision. Do not edit by hand; re-render via:
#   python3 ${CLAUDE_PLUGIN_ROOT}/skills/agent-sandbox-provision/scripts/render_launcher.py
# (or, outside a Claude Code session, the render_launcher.py under wherever the
# agent-sandbox-provision plugin is installed, e.g.
# ~/.claude/plugins/cache/agent-sandbox-provision@amit-cc-plugins/skills/agent-sandbox-provision/scripts/)
#
# Compatible with bash 3.2 (the macOS default /bin/bash).
#
# AWS, Kubernetes, GitHub, MongoDB, and the Mongo SOCKS tunnels are all
# broker-on-demand INSIDE the sandbox — nothing is minted, selected, or created here.
# claude-ro mints per-account AWS creds + kubeconfig (claude-ro-mint-aws-<account>),
# GitHub tokens, Mongo URIs, and stands up a per-session cluster SOCKS tunnel on demand
# (claude-ro-tunnel-<cluster> <session> [port]), each via a pinned `sudo -u <user> …`
# broker that writes to files under /usr/local/claude-ro-runtime — never through the env
# or the model. `claude-ro-capabilities` (printed each session) documents the ordering.
#
# The launcher's only jobs beyond the sandbox handoff: give this session a stable id
# (CLAUDE_RO_SESSION = the launcher PID) so the tunnel broker can tag this session's
# tunnels, and tear down ONLY this session's tunnels on exit (the brokers create them
# per session but can't own the session lifetime — the launcher outlives it).

set -euo pipefail

SESSION_ID=$$

# Everything on the command line is forwarded to claude untouched.
PASSTHROUGH=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift; PASSTHROUGH+=("$@"); break ;;
    *)  PASSTHROUGH+=("$1"); shift ;;
  esac
done

# ---------- Mongo SOCKS tunnel teardown (this session only, on exit) ----------
# The per-cluster claude-ro-tunnel-<cluster> broker, invoked with this session's id,
# records each tunnel it starts in
#     /usr/local/claude-ro-runtime/tunnel/<session_id>.<port>.pid
# as "<pf_pid>\t<deployment>\t<context>". On exit we kill this session's port-forwards
# and delete their proxy Deployments — scoped to SESSION_ID, so concurrent sessions are
# left untouched.
cleanup_tunnels() {
  local f pid dep ctx
  for f in /usr/local/claude-ro-runtime/tunnel/"$SESSION_ID".*.pid; do
    [ -f "$f" ] || continue
    read -r pid dep ctx < "$f"
    [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
    if [ -n "$dep" ] && [ -n "$ctx" ]; then
      kubectl --context "$ctx" delete deployment "$dep" --wait=false >/dev/null 2>&1 || true
    fi
    rm -f "$f" 2>/dev/null || true
  done
}
trap 'cleanup_tunnels' EXIT

# Strip env, re-establish only what's needed, hand off to claude-ro.
# `${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}` is the bash-3.2-safe empty-array idiom
# under `set -u`; plain `"${PASSTHROUGH[@]}"` would crash when no extra args were given.
#
# Terminal-identification vars are forwarded through the env wipe so Claude Code's TUI
# can detect modern terminals (iTerm2/Kitty/WezTerm/etc.) and enable extended input.
# CLAUDE_RO_SESSION is this session's tunnel tag — the agent passes it to the tunnel
# broker so teardown is per-session.
#
# No AWS creds, region, or KUBECONFIG are injected: AWS + k8s are broker-on-demand
# inside the sandbox. NOT exec: the launcher must outlive the session to run the EXIT
# trap (tunnel teardown). Exit code is propagated.
RC=0
sudo -u claude-ro env -i \
  HOME=/Users/claude-ro \
  PATH=/usr/local/bin:/usr/bin:/bin \
  CLAUDE_RO_SESSION="$SESSION_ID" \
  TERM="${TERM:-xterm-256color}" \
  TERM_PROGRAM="${TERM_PROGRAM-}" \
  TERM_PROGRAM_VERSION="${TERM_PROGRAM_VERSION-}" \
  LC_TERMINAL="${LC_TERMINAL-}" \
  LC_TERMINAL_VERSION="${LC_TERMINAL_VERSION-}" \
  COLORTERM="${COLORTERM-}" \
  ITERM_SESSION_ID="${ITERM_SESSION_ID-}" \
  KITTY_WINDOW_ID="${KITTY_WINDOW_ID-}" \
  WEZTERM_PANE="${WEZTERM_PANE-}" \
  /bin/sh -c '
    # Unlock the claude-ro login keychain so Claude Code can read/write its
    # OAuth token without a GUI prompt. Empty password, provisioned by init.
    # A no-GUI security session re-locks between launches, so unlock per launch.
    # Non-fatal: if the keychain is absent (pre-migration install), CC behaves
    # as it did before.
    security unlock-keychain -p "" "$HOME/Library/Keychains/login.keychain-db" 2>/dev/null
    exec claude "$@"
  ' claude-ro ${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"} || RC=$?
exit "$RC"
