#!{{PYTHON}}
# Generated by agent-sandbox (provision-account). Do NOT edit by hand;
# re-created by provision-account, removed by deprovision-account.
#
# Per-ACCOUNT, on-demand mint helper for AWS account {{ACCOUNT_ID}}. Runs as the
# REAL user, called by claude-ro through a pinned
#     sudo -u <user> /usr/local/bin/claude-ro-mint-aws-{{ACCOUNT_ID}} [region]
# rule (see /etc/sudoers.d/claude-ro-mint-aws-{{ACCOUNT_ID}}). It assumes THIS
# account's read-only role using the engineer's own AWS profile — which claude-ro
# cannot read; that profile is the durable secret here, analogous to the GitHub App
# private key — and then:
#   1. writes short-lived read-only credentials to
#        /usr/local/claude-ro-runtime/aws/{{ACCOUNT_ID}}.credentials
#   2. enumerates the account's EKS clusters WITH those creds and writes a kubeconfig
#      (each cluster's aws-eks-get-token pinned to the credentials file above) to
#        /usr/local/claude-ro-runtime/aws/{{ACCOUNT_ID}}.kubeconfig
# Both are mode-600 files claude-ro reads via the runtime dir's inherited allow-ACE;
# credential VALUES never transit stdout. To stdout it prints ONLY non-secret
# metadata: the account id, the region used, and the two file paths.
#
# The ONLY thing argv can influence is which region's clusters are enumerated:
# argv[1], if present, is validated against the real AWS/EKS region list and rejected
# otherwise (see _common.sanitize_eks_region). The account, role, and read-only scope
# are hardcoded below and cannot be changed by anything claude-ro passes.
from __future__ import annotations

import os
import pwd
import sys

sys.path.insert(0, "{{SKILL_SCRIPTS_DIR}}")
import _common as common  # noqa: E402

ACCOUNT_ID = "{{ACCOUNT_ID}}"
DEFAULT_REGION = "{{DEFAULT_REGION}}"


def main() -> None:
    # Ensure ~ resolves to the invoking (real) user's home so botocore finds the AWS
    # profile, regardless of how sudo set HOME for this process.
    os.environ["HOME"] = pwd.getpwuid(os.getuid()).pw_dir

    if len(sys.argv) > 2:
        print(f"usage: {os.path.basename(sys.argv[0])} [region]", file=sys.stderr)
        sys.exit(2)
    region = sys.argv[1] if len(sys.argv) > 1 else DEFAULT_REGION
    region = common.sanitize_eks_region(region)

    record = common.aws_account_record(ACCOUNT_ID)
    aws = common.load_provider("aws")

    creds_path = common.runtime_cred_path("aws", ACCOUNT_ID + ".credentials")
    result = aws.mint(record, str(creds_path), region=region)

    common.write_runtime_cred("aws", ACCOUNT_ID + ".credentials", result["credentials_ini"])
    kube_path = common.write_runtime_cred(
        "aws", ACCOUNT_ID + ".kubeconfig", result["kubeconfig_yaml"])

    # Non-secret metadata only: account, region, and the two file paths.
    sys.stdout.write(f"{ACCOUNT_ID} {result['region']} {creds_path} {kube_path}\n")


if __name__ == "__main__":
    main()
